# Copy this file to .env and fill in the values you need.

# --- LLM provider ---
# Choose one: gemini | anthropic | openai
# "gemini" is RECOMMENDED if you don't already have paid API billing set up:
#   Google AI Studio gives a genuine free tier, no credit card required.
#   Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini

# Required if LLM_PROVIDER=gemini (free tier, no card needed)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required if LLM_PROVIDER=anthropic (no free tier -- prepaid credit only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Required if LLM_PROVIDER=openai (limited/no free tier currently)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings provider (for the RAG knowledge base) ---
# Choose one: fastembed | local | huggingface | openai
# "fastembed" (DEFAULT) - real transformer embeddings (BAAI/BGE family) via
#   ONNX Runtime. Free, no API key, no PyTorch. Downloads ~65MB model weights
#   from huggingface.co on first run.
# "local" - TF-IDF+SVD, NO download at all, works fully offline, but weaker
#   semantic matching. Use this if you can't reach huggingface.co.
# "huggingface" - sentence-transformers (needs `pip install
#   sentence-transformers`, which pulls in PyTorch — heavier install). Use
#   this specifically if you want the exact BAAI/bge-m3 model.
# "openai" - OpenAI's embedding API (needs OPENAI_API_KEY).
EMBEDDING_PROVIDER=fastembed

# Only used if EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Only used if EMBEDDING_PROVIDER=huggingface (e.g. set to BAAI/bge-m3)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Only used if EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
