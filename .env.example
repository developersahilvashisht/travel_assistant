# Copy this file to .env and fill in the values you need.

# --- LLM provider ---
# Choose one: anthropic | openai
LLM_PROVIDER=anthropic

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings provider (for the RAG knowledge base) ---
# Choose one: local | huggingface | openai
# "local" needs NO API key and NO extra download (TF-IDF+SVD) - default, works
#   immediately but with weaker semantic matching. Good to get started.
# "huggingface" uses sentence-transformers locally (better quality, ~100MB
#   download, no API key, needs `pip install sentence-transformers`).
# "openai" uses OpenAI's embedding API (best quality, needs OPENAI_API_KEY).
EMBEDDING_PROVIDER=local

# Only used if EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Only used if EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
